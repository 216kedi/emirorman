# Application
APP_NAME=production-ai-app
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json  # json | console

# Auth
API_KEY=                        # empty = auth disabled (development only)
RATE_LIMIT_PER_MINUTE=60

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic  # anthropic | openai
DEFAULT_LLM_MODEL=claude-opus-4-7
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=prod_ai_app

# Cache
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_THRESHOLD=0.93

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=   # grpc://otel-collector:4317

# Safety
ENABLE_INPUT_GUARD=true
ENABLE_OUTPUT_GUARD=true

# Elis Evleri — WhatsApp / Meta Cloud API (duman/gaz alarm bildirimleri)
# ESP32'ler /alerts/sensor endpoint'ine POST atar (üstteki API_KEY ile, x-api-key başlığı).
BUILDING_NAME=Elis Evleri
WHATSAPP_ACCESS_TOKEN=            # Meta System User kalıcı access token
WHATSAPP_PHONE_NUMBER_ID=        # WhatsApp gönderen numarasının Phone Number ID'si
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=elis_alarm
WHATSAPP_TEMPLATE_LANG=tr
WHATSAPP_RECIPIENTS=             # virgülle ayrık E.164, örn: +905551112233,+905554445566
ALERT_COOLDOWN_SECONDS=60        # aynı kat+sensör için tekrar gönderim engelleme penceresi
